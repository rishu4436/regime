# Frontend API selection (Vite reads VITE_* at build/dev time). No secrets here.
# mock = in-browser mock API (default, no backend needed) | http = Bot 6's FastAPI (REST + WS)
VITE_API_MODE=mock
# Base URL of the backend when VITE_API_MODE=http. Empty = same origin (npm run dev proxies /api, /ws to :8000).
VITE_API_URL=
