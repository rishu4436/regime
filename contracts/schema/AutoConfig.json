{
  "$defs": {
    "ActivationMode": {
      "description": "How an approved signal is executed. AUTO_EXECUTE = execute immediately, CONFIRMATION = wait for the user.",
      "enum": [
        "AUTO_EXECUTE",
        "CONFIRMATION"
      ],
      "title": "ActivationMode",
      "type": "string"
    },
    "PresetName": {
      "enum": [
        "DCA",
        "SMART_DCA",
        "BUY_THE_DIP",
        "TREND_FOLLOWING",
        "GRID"
      ],
      "title": "PresetName",
      "type": "string"
    },
    "Timeframe": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "4h",
        "1d"
      ],
      "title": "Timeframe",
      "type": "string"
    },
    "TraderStyle": {
      "enum": [
        "PATIENT",
        "BALANCED",
        "ACTIVE"
      ],
      "title": "TraderStyle",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activation": {
      "$ref": "#/$defs/ActivationMode",
      "default": "CONFIRMATION"
    },
    "capital": {
      "description": "USDT allocated to the auto agent",
      "exclusiveMinimum": 0,
      "title": "Capital",
      "type": "number"
    },
    "enabled_presets": {
      "items": {
        "$ref": "#/$defs/PresetName"
      },
      "minItems": 1,
      "title": "Enabled Presets",
      "type": "array"
    },
    "style": {
      "$ref": "#/$defs/TraderStyle",
      "default": "BALANCED"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "timeframe": {
      "$ref": "#/$defs/Timeframe",
      "default": "1h"
    }
  },
  "required": [
    "symbol",
    "capital"
  ],
  "title": "AutoConfig",
  "type": "object"
}
