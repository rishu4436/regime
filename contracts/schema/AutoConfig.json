{
  "$defs": {
    "ActivationMode": {
      "description": "How an approved signal is executed. AUTO_EXECUTE = execute immediately, CONFIRMATION = wait for the user.",
      "enum": [
        "AUTO_EXECUTE",
        "CONFIRMATION"
      ],
      "title": "ActivationMode",
      "type": "string"
    },
    "AutoPickConfig": {
      "additionalProperties": false,
      "description": "Watchlist Auto-pick (v0.3): pick up to ``max_tokens`` tradable tokens of one narrative by momentum/trend/liquidity.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "max_tokens": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Tokens",
          "type": "integer"
        },
        "narrative": {
          "default": "ANY",
          "enum": [
            "AI_CHIPS",
            "EV_ENERGY",
            "BIG_TECH",
            "CRYPTO",
            "ANY"
          ],
          "title": "Narrative",
          "type": "string"
        }
      },
      "title": "AutoPickConfig",
      "type": "object"
    },
    "PresetName": {
      "enum": [
        "DCA",
        "SMART_DCA",
        "BUY_THE_DIP",
        "TREND_FOLLOWING",
        "GRID"
      ],
      "title": "PresetName",
      "type": "string"
    },
    "Timeframe": {
      "enum": [
        "1m",
        "5m",
        "15m",
        "1h",
        "4h",
        "1d"
      ],
      "title": "Timeframe",
      "type": "string"
    },
    "TraderStyle": {
      "enum": [
        "PATIENT",
        "BALANCED",
        "ACTIVE"
      ],
      "title": "TraderStyle",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "activation": {
      "$ref": "#/$defs/ActivationMode",
      "default": "CONFIRMATION"
    },
    "auto_pick": {
      "$ref": "#/$defs/AutoPickConfig",
      "description": "v0.3: pick the watchlist automatically (off by default)"
    },
    "capital": {
      "description": "USDT allocated to the auto agent",
      "exclusiveMinimum": 0,
      "title": "Capital",
      "type": "number"
    },
    "enabled_presets": {
      "items": {
        "$ref": "#/$defs/PresetName"
      },
      "minItems": 1,
      "title": "Enabled Presets",
      "type": "array"
    },
    "style": {
      "$ref": "#/$defs/TraderStyle",
      "default": "BALANCED"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "timeframe": {
      "$ref": "#/$defs/Timeframe",
      "default": "1h"
    },
    "watchlist": {
      "description": "v0.3: up to 5 tokens for the auto agent; empty = [symbol]. `symbol` stays the first entry",
      "items": {
        "type": "string"
      },
      "maxItems": 5,
      "title": "Watchlist",
      "type": "array"
    }
  },
  "required": [
    "symbol",
    "capital"
  ],
  "title": "AutoConfig",
  "type": "object"
}
