{
  "$defs": {
    "Action": {
      "enum": [
        "BUY",
        "SELL",
        "STAY_OUT"
      ],
      "title": "Action",
      "type": "string"
    },
    "ActivationMode": {
      "description": "How an approved signal is executed. AUTO_EXECUTE = execute immediately, CONFIRMATION = wait for the user.",
      "enum": [
        "AUTO_EXECUTE",
        "CONFIRMATION"
      ],
      "title": "ActivationMode",
      "type": "string"
    },
    "AgentMode": {
      "description": "Which brain produced a signal: the user's rule set (MANUAL) or the regime-driven preset selector (AUTO).",
      "enum": [
        "MANUAL",
        "AUTO"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "AutoConfig": {
      "additionalProperties": false,
      "properties": {
        "activation": {
          "$ref": "#/$defs/ActivationMode",
          "default": "CONFIRMATION"
        },
        "capital": {
          "description": "USDT allocated to the auto agent",
          "exclusiveMinimum": 0,
          "title": "Capital",
          "type": "number"
        },
        "enabled_presets": {
          "items": {
            "$ref": "#/$defs/PresetName"
          },
          "minItems": 1,
          "title": "Enabled Presets",
          "type": "array"
        },
        "style": {
          "$ref": "#/$defs/TraderStyle",
          "default": "BALANCED"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "timeframe": {
          "$ref": "#/$defs/Timeframe",
          "default": "1h"
        }
      },
      "required": [
        "symbol",
        "capital"
      ],
      "title": "AutoConfig",
      "type": "object"
    },
    "BacktestResult": {
      "additionalProperties": false,
      "properties": {
        "equity_curve": {
          "items": {
            "$ref": "#/$defs/EquityPoint"
          },
          "title": "Equity Curve",
          "type": "array"
        },
        "final_equity": {
          "title": "Final Equity",
          "type": "number"
        },
        "initial_capital": {
          "title": "Initial Capital",
          "type": "number"
        },
        "max_drawdown_pct": {
          "title": "Max Drawdown Pct",
          "type": "number"
        },
        "num_trades": {
          "title": "Num Trades",
          "type": "integer"
        },
        "strategy_name": {
          "title": "Strategy Name",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "total_return_pct": {
          "title": "Total Return Pct",
          "type": "number"
        },
        "trades": {
          "items": {
            "$ref": "#/$defs/BacktestTrade"
          },
          "title": "Trades",
          "type": "array"
        },
        "win_rate_pct": {
          "title": "Win Rate Pct",
          "type": "number"
        }
      },
      "required": [
        "strategy_name",
        "symbol",
        "initial_capital",
        "final_equity",
        "total_return_pct",
        "max_drawdown_pct",
        "win_rate_pct",
        "num_trades"
      ],
      "title": "BacktestResult",
      "type": "object"
    },
    "BacktestTrade": {
      "additionalProperties": false,
      "properties": {
        "entry_price": {
          "title": "Entry Price",
          "type": "number"
        },
        "entry_time": {
          "format": "date-time",
          "title": "Entry Time",
          "type": "string"
        },
        "exit_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Price"
        },
        "exit_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExitReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "exit_time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Exit Time"
        },
        "pnl": {
          "default": 0.0,
          "title": "Pnl",
          "type": "number"
        },
        "pnl_pct": {
          "default": 0.0,
          "title": "Pnl Pct",
          "type": "number"
        },
        "quantity": {
          "title": "Quantity",
          "type": "number"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "entry_time",
        "entry_price",
        "quantity"
      ],
      "title": "BacktestTrade",
      "type": "object"
    },
    "BollingerLowerCondition": {
      "additionalProperties": false,
      "description": "sim:useBB. True when close < lower_band * (1 + proximity_pct/100) (i.e. near OR below the band).",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "period": {
          "default": 20,
          "minimum": 2,
          "title": "Period",
          "type": "integer"
        },
        "proximity_pct": {
          "default": 2.0,
          "description": "Simulator uses close < lower * 1.02",
          "minimum": 0,
          "title": "Proximity Pct",
          "type": "number"
        },
        "std_dev": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "title": "Std Dev",
          "type": "number"
        }
      },
      "title": "BollingerLowerCondition",
      "type": "object"
    },
    "BreakoutCondition": {
      "additionalProperties": false,
      "description": "PDF-only (not in the simulator). HIGH: close > max(high of previous `lookback` bars);\nLOW: close < min(low of previous `lookback` bars).",
      "properties": {
        "direction": {
          "$ref": "#/$defs/BreakoutDirection",
          "default": "HIGH"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "lookback": {
          "default": 20,
          "minimum": 2,
          "title": "Lookback",
          "type": "integer"
        }
      },
      "title": "BreakoutCondition",
      "type": "object"
    },
    "BreakoutDirection": {
      "description": "Price-action breakout: break of the recent HIGH (bullish) or recent LOW.",
      "enum": [
        "HIGH",
        "LOW"
      ],
      "title": "BreakoutDirection",
      "type": "string"
    },
    "Candle": {
      "additionalProperties": false,
      "properties": {
        "close": {
          "exclusiveMinimum": 0,
          "title": "Close",
          "type": "number"
        },
        "high": {
          "exclusiveMinimum": 0,
          "title": "High",
          "type": "number"
        },
        "low": {
          "exclusiveMinimum": 0,
          "title": "Low",
          "type": "number"
        },
        "open": {
          "exclusiveMinimum": 0,
          "title": "Open",
          "type": "number"
        },
        "timestamp": {
          "description": "Candle open time (UTC)",
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "volume": {
          "minimum": 0,
          "title": "Volume",
          "type": "number"
        }
      },
      "required": [
        "timestamp",
        "open",
        "high",
        "low",
        "close",
        "volume"
      ],
      "title": "Candle",
      "type": "object"
    },
    "ConditionLogic": {
      "enum": [
        "AND",
        "OR"
      ],
      "title": "ConditionLogic",
      "type": "string"
    },
    "ControlState": {
      "additionalProperties": false,
      "properties": {
        "confirmation_mode": {
          "default": true,
          "title": "Confirmation Mode",
          "type": "boolean"
        },
        "emergency_stopped": {
          "default": false,
          "title": "Emergency Stopped",
          "type": "boolean"
        },
        "paused": {
          "default": false,
          "title": "Paused",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "trading_mode": {
          "$ref": "#/$defs/TradingMode",
          "default": "SIM"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "title": "ControlState",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "Final, fully explainable record of one evaluation cycle (regime + strategy + reason).",
      "properties": {
        "action": {
          "$ref": "#/$defs/Action"
        },
        "agent_mode": {
          "$ref": "#/$defs/AgentMode"
        },
        "execution": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Plain-language text from the LLM layer (Bot 5)",
          "title": "Explanation"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/TradingMode"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "regime": {
          "anyOf": [
            {
              "$ref": "#/$defs/Regime"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "risk_verdict": {
          "anyOf": [
            {
              "$ref": "#/$defs/RiskVerdict"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "signal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Signal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "strategy": {
          "title": "Strategy",
          "type": "string"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "agent_mode",
        "symbol",
        "strategy",
        "action",
        "reason"
      ],
      "title": "Decision",
      "type": "object"
    },
    "EntryConditions": {
      "additionalProperties": false,
      "description": "Combination semantics (simulator): each ENABLED condition whose indicator is available (not in warm-up)\ncontributes one boolean; conditions whose indicator is still null are skipped, not counted as false.\nIf no booleans were produced -> no entry. AND = all true (sim: every), OR = at least one true (sim: some).\nCanonical names for Signal.conditions_met/failed are the field names below.",
      "properties": {
        "bollinger_lower": {
          "$ref": "#/$defs/BollingerLowerCondition"
        },
        "breakout": {
          "$ref": "#/$defs/BreakoutCondition"
        },
        "logic": {
          "$ref": "#/$defs/ConditionLogic",
          "default": "AND"
        },
        "macd_bullish_cross": {
          "$ref": "#/$defs/MacdCrossCondition"
        },
        "price_above_ema": {
          "$ref": "#/$defs/PriceAboveEmaCondition"
        },
        "price_above_sma": {
          "$ref": "#/$defs/PriceAboveSmaCondition"
        },
        "rsi_below": {
          "$ref": "#/$defs/RsiBelowCondition"
        },
        "volume_above_avg": {
          "$ref": "#/$defs/VolumeAboveAverageCondition"
        }
      },
      "title": "EntryConditions",
      "type": "object"
    },
    "EquityPoint": {
      "additionalProperties": false,
      "properties": {
        "equity": {
          "title": "Equity",
          "type": "number"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "equity"
      ],
      "title": "EquityPoint",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "description": "Envelope for WebSocket messages and structured logs.",
      "properties": {
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EventType"
        }
      },
      "required": [
        "type"
      ],
      "title": "Event",
      "type": "object"
    },
    "EventType": {
      "description": "WebSocket / log event kinds pushed from backend/app to the frontend.",
      "enum": [
        "DECISION",
        "EXECUTION",
        "CONTROL",
        "PRICE",
        "ALERT",
        "STATUS"
      ],
      "title": "EventType",
      "type": "string"
    },
    "ExecutionPath": {
      "enum": [
        "SWAP",
        "RFQ"
      ],
      "title": "ExecutionPath",
      "type": "string"
    },
    "ExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "avg_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Avg Price"
        },
        "client_order_id": {
          "title": "Client Order Id",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "fee": {
          "default": 0.0,
          "minimum": 0,
          "title": "Fee",
          "type": "number"
        },
        "filled_quantity": {
          "default": 0.0,
          "minimum": 0,
          "title": "Filled Quantity",
          "type": "number"
        },
        "mode": {
          "$ref": "#/$defs/TradingMode"
        },
        "notional": {
          "default": 0.0,
          "minimum": 0,
          "title": "Notional",
          "type": "number"
        },
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "path": {
          "$ref": "#/$defs/ExecutionPath"
        },
        "side": {
          "$ref": "#/$defs/OrderSide"
        },
        "status": {
          "$ref": "#/$defs/OrderStatus"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "tx_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tx Hash"
        }
      },
      "required": [
        "client_order_id",
        "symbol",
        "side",
        "status",
        "path",
        "mode"
      ],
      "title": "ExecutionResult",
      "type": "object"
    },
    "ExitReason": {
      "description": "Why a position was closed. First five mirror the simulator's reasons in priority order.",
      "enum": [
        "TRAILING_STOP",
        "TAKE_PROFIT",
        "STOP_LOSS",
        "RSI_EXIT",
        "MACD_EXIT",
        "END",
        "MAX_LOSS",
        "MANUAL",
        "EMERGENCY_STOP"
      ],
      "title": "ExitReason",
      "type": "string"
    },
    "ExitRules": {
      "additionalProperties": false,
      "description": "Evaluated on each bar's close BEFORE entries, first match wins, in this order (simulator):\nTRAILING_STOP -> TAKE_PROFIT (pnl >= tp) -> STOP_LOSS (pnl <= -sl) -> RSI_EXIT -> MACD_EXIT.\nOpen positions are closed with reason END at the end of a backtest.",
      "properties": {
        "macd_bearish_cross": {
          "$ref": "#/$defs/MacdCrossCondition"
        },
        "rsi_above": {
          "$ref": "#/$defs/RsiExitRule"
        },
        "stop_loss_pct": {
          "default": 6.0,
          "exclusiveMinimum": 0,
          "title": "Stop Loss Pct",
          "type": "number"
        },
        "take_profit_pct": {
          "default": 12.0,
          "exclusiveMinimum": 0,
          "title": "Take Profit Pct",
          "type": "number"
        },
        "trailing_stop": {
          "$ref": "#/$defs/TrailingStopRule"
        }
      },
      "title": "ExitRules",
      "type": "object"
    },
    "MacdCrossCondition": {
      "additionalProperties": false,
      "description": "Entry (sim:useMACD): line crosses ABOVE signal this bar (line[i] > sig[i] and line[i-1] <= sig[i-1]).\nExit (sim:useMacdExit): line crosses BELOW signal (line[i] < sig[i] and line[i-1] > sig[i-1]).",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "params": {
          "$ref": "#/$defs/MacdParams"
        }
      },
      "title": "MacdCrossCondition",
      "type": "object"
    },
    "MacdParams": {
      "additionalProperties": false,
      "properties": {
        "fast": {
          "default": 12,
          "minimum": 1,
          "title": "Fast",
          "type": "integer"
        },
        "signal": {
          "default": 9,
          "description": "Simulator approximates a 9-period signal EMA with alpha=0.15",
          "minimum": 1,
          "title": "Signal",
          "type": "integer"
        },
        "slow": {
          "default": 26,
          "minimum": 2,
          "title": "Slow",
          "type": "integer"
        }
      },
      "title": "MacdParams",
      "type": "object"
    },
    "ManualStrategy": {
      "additionalProperties": false,
      "description": "A user-built rule set (spec 2.1/2.2). Saved and exchanged as JSON. Defaults == simulator defaults.",
      "properties": {
        "activation": {
          "$ref": "#/$defs/ActivationMode",
          "default": "CONFIRMATION"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "entry": {
          "$ref": "#/$defs/EntryConditions"
        },
        "exit": {
          "$ref": "#/$defs/ExitRules"
        },
        "filters": {
          "$ref": "#/$defs/StrategyFilters"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "default": "My Strategy",
          "title": "Name",
          "type": "string"
        },
        "risk": {
          "$ref": "#/$defs/PositionRiskRules"
        },
        "symbol": {
          "default": "NVDAon",
          "description": "Token symbol (sim:token): NVDAon, TSLAx, AAPLB, ...",
          "title": "Symbol",
          "type": "string"
        },
        "timeframe": {
          "$ref": "#/$defs/Timeframe",
          "default": "1h"
        },
        "version": {
          "default": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "title": "ManualStrategy",
      "type": "object"
    },
    "MarketHoursFilter": {
      "additionalProperties": false,
      "description": "sim:marketHours. Real engine: only trade when bar time is within [start, end) UTC (weekdays if set).\nThe simulator fakes this as bar_index % 24 < 16.",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "end_hour_utc": {
          "default": 20,
          "maximum": 24,
          "minimum": 0,
          "title": "End Hour Utc",
          "type": "integer"
        },
        "start_hour_utc": {
          "default": 13,
          "maximum": 23,
          "minimum": 0,
          "title": "Start Hour Utc",
          "type": "integer"
        },
        "weekdays_only": {
          "default": true,
          "title": "Weekdays Only",
          "type": "boolean"
        }
      },
      "title": "MarketHoursFilter",
      "type": "object"
    },
    "MinVolumeFilter": {
      "additionalProperties": false,
      "description": "sim:minVol ('Require above-average volume'). Hard gate: volume > multiplier * average volume\n(same average as VolumeAboveAverageCondition) and, if set, volume >= min_volume (absolute, PDF).",
      "properties": {
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "min_volume": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Volume"
        },
        "multiplier": {
          "default": 1.1,
          "exclusiveMinimum": 0,
          "title": "Multiplier",
          "type": "number"
        }
      },
      "title": "MinVolumeFilter",
      "type": "object"
    },
    "OrderRequest": {
      "additionalProperties": false,
      "properties": {
        "client_order_id": {
          "title": "Client Order Id",
          "type": "string"
        },
        "decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Id"
        },
        "mode": {
          "$ref": "#/$defs/TradingMode",
          "default": "SIM"
        },
        "notional": {
          "description": "USDT amount for BUY; for SELL the USDT value to sell",
          "exclusiveMinimum": 0,
          "title": "Notional",
          "type": "number"
        },
        "path": {
          "$ref": "#/$defs/ExecutionPath",
          "default": "SWAP"
        },
        "quantity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Exact token qty (SELL); overrides notional",
          "title": "Quantity"
        },
        "quote_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote Id"
        },
        "side": {
          "$ref": "#/$defs/OrderSide"
        },
        "slippage_bps": {
          "default": 50,
          "minimum": 0,
          "title": "Slippage Bps",
          "type": "integer"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "side",
        "notional"
      ],
      "title": "OrderRequest",
      "type": "object"
    },
    "OrderSide": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "OrderSide",
      "type": "string"
    },
    "OrderStatus": {
      "enum": [
        "FILLED",
        "PARTIALLY_FILLED",
        "PENDING_CONFIRMATION",
        "REJECTED",
        "EXPIRED",
        "FAILED"
      ],
      "title": "OrderStatus",
      "type": "string"
    },
