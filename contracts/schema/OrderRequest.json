{
  "$defs": {
    "ExecutionPath": {
      "enum": [
        "SWAP",
        "RFQ"
      ],
      "title": "ExecutionPath",
      "type": "string"
    },
    "OrderSide": {
      "enum": [
        "BUY",
        "SELL"
      ],
      "title": "OrderSide",
      "type": "string"
    },
    "TradingMode": {
      "description": "Execution environment. SIM = mocks/offline, PAPER = real market data + simulated fills, LIVE = real money.",
      "enum": [
        "SIM",
        "PAPER",
        "LIVE"
      ],
      "title": "TradingMode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "client_order_id": {
      "title": "Client Order Id",
      "type": "string"
    },
    "decision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision Id"
    },
    "mode": {
      "$ref": "#/$defs/TradingMode",
      "default": "SIM"
    },
    "notional": {
      "description": "USDT amount for BUY; for SELL the USDT value to sell",
      "exclusiveMinimum": 0,
      "title": "Notional",
      "type": "number"
    },
    "path": {
      "$ref": "#/$defs/ExecutionPath",
      "default": "SWAP"
    },
    "quantity": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Exact token qty (SELL); overrides notional",
      "title": "Quantity"
    },
    "quote_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Quote Id"
    },
    "side": {
      "$ref": "#/$defs/OrderSide"
    },
    "slippage_bps": {
      "default": 50,
      "minimum": 0,
      "title": "Slippage Bps",
      "type": "integer"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    }
  },
  "required": [
    "symbol",
    "side",
    "notional"
  ],
  "title": "OrderRequest",
  "type": "object"
}
