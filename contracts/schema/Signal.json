{
  "$defs": {
    "Action": {
      "enum": [
        "BUY",
        "SELL",
        "STAY_OUT"
      ],
      "title": "Action",
      "type": "string"
    },
    "AgentMode": {
      "description": "Which brain produced a signal: the user's rule set (MANUAL) or the regime-driven preset selector (AUTO).",
      "enum": [
        "MANUAL",
        "AUTO"
      ],
      "title": "AgentMode",
      "type": "string"
    },
    "ExitReason": {
      "description": "Why a position was closed. First five mirror the simulator's reasons in priority order.",
      "enum": [
        "TRAILING_STOP",
        "TAKE_PROFIT",
        "STOP_LOSS",
        "RSI_EXIT",
        "MACD_EXIT",
        "END",
        "MAX_LOSS",
        "MANUAL",
        "EMERGENCY_STOP"
      ],
      "title": "ExitReason",
      "type": "string"
    },
    "PresetName": {
      "enum": [
        "DCA",
        "SMART_DCA",
        "BUY_THE_DIP",
        "TREND_FOLLOWING",
        "GRID"
      ],
      "title": "PresetName",
      "type": "string"
    },
    "Regime": {
      "description": "The six market regimes from spec section 3.1.",
      "enum": [
        "STRONG_UPTREND",
        "MILD_UPTREND",
        "SIDEWAYS",
        "OVERSOLD_PULLBACK",
        "HIGH_VOLATILITY",
        "DOWNTREND"
      ],
      "title": "Regime",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Proposed action from the strategy engine (Bot 2) or an exit from RiskManager.check_exits (Bot 3).\nNever executed without a RiskVerdict. For SELL signals `price` is the intended fill price (e.g. the SL/TP level\nor gap-open price per ExitRules), `exit_reason` says why, and `position_id` targets a specific Position.",
  "properties": {
    "action": {
      "$ref": "#/$defs/Action"
    },
    "conditions_failed": {
      "items": {
        "type": "string"
      },
      "title": "Conditions Failed",
      "type": "array"
    },
    "conditions_met": {
      "items": {
        "type": "string"
      },
      "title": "Conditions Met",
      "type": "array"
    },
    "exit_reason": {
      "anyOf": [
        {
          "$ref": "#/$defs/ExitReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "position_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Position.id this SELL closes",
      "title": "Position Id"
    },
    "preset": {
      "anyOf": [
        {
          "$ref": "#/$defs/PresetName"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "price": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "BUY: reference price; SELL: fill price (level or gap open)",
      "title": "Price"
    },
    "proposed_notional": {
      "default": 0.0,
      "minimum": 0,
      "title": "Proposed Notional",
      "type": "number"
    },
    "proposed_size_pct": {
      "default": 0.0,
      "maximum": 100,
      "minimum": 0,
      "title": "Proposed Size Pct",
      "type": "number"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "regime": {
      "anyOf": [
        {
          "$ref": "#/$defs/Regime"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "$ref": "#/$defs/AgentMode"
    },
    "strategy": {
      "description": "Preset name (AUTO) or 'MANUAL:<name>'",
      "title": "Strategy",
      "type": "string"
    },
    "symbol": {
      "title": "Symbol",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "symbol",
    "action",
    "source",
    "strategy",
    "reason"
  ],
  "title": "Signal",
  "type": "object"
}
